WOOCOMMERCE_URL=http://localhost:8080
# From WooCommerce → Settings → Advanced → REST API (shown once). Must start with ck_ / cs_.
# Do not copy the consumer_key column from the database; it stores an HMAC hash, not the plain key.
# For http://localhost (port-forward), deploy Helm with wordpress.allowHttpRestAuth: true or use OAuth 1.0a.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
