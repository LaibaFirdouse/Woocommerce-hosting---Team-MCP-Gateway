# Gateway PostgreSQL (placeholder credentials — do not use in production)
DATABASE_URL=postgresql+psycopg://urumi:change_me@localhost:5432/urumi_gateway

# HTTP / MCP auth (gateway). AUTH_JWT_SECRET must be ≥32 random characters.
# AUTH_JWT_SECRET=
# MCP_AUTH_REQUIRED=true
# GATEWAY_PUBLIC_URL=http://127.0.0.1:8001
# UPSTREAM_SECRETS_KEY=
# GATEWAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# AUTH_COOKIE_SECURE=false
# Prefer http://127.0.0.1:5173 for the Vite dashboard so the API host in
# apps/dashboard/.env (VITE_GATEWAY_API_URL=http://127.0.0.1:8001) matches.
# Mixing localhost and 127.0.0.1 breaks SameSite=Lax session cookies.

# Chat agent LLM (gateway only — never expose to the Vite dashboard).
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# CHAT_MAX_TOOL_ROUNDS=6
# CHAT_TIMEOUT_SECONDS=60
